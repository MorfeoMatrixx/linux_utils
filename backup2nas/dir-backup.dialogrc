#
# dir-backup.sh theme - vintage green phosphor terminal
# Dim green on black for normal text/borders, bold/bright green for
# titles, and high-brightness reverse-video (bold green field, black
# text) for active selections and buttons.
#
# NOTE on the (fg,bg,highlight,underline,reverse) 5-field form below:
# "highlight" (bold) only intensifies the FOREGROUND slot, never the
# background. So fg is set to GREEN (which bold brightens) and the
# "reverse" flag swaps fg/bg at render time - giving a genuinely
# bright green field with black text, instead of a dim one.
#

aspect = 0
separate_widget = ""
tab_len = 0
visit_items = OFF
use_scrollbar = ON
use_shadow = OFF
use_colors = ON

screen_color = (GREEN,BLACK,OFF)
shadow_color = (BLACK,BLACK,ON)
dialog_color = (GREEN,BLACK,OFF)
title_color = (GREEN,BLACK,ON)
border_color = (GREEN,BLACK,OFF)
button_active_color = (GREEN,BLACK,ON,OFF,ON)
button_inactive_color = dialog_color
button_key_active_color = button_active_color
button_key_inactive_color = (GREEN,BLACK,ON)
button_label_active_color = (GREEN,BLACK,ON,OFF,ON)
button_label_inactive_color = (GREEN,BLACK,OFF)
inputbox_color = (GREEN,BLACK,OFF)
inputbox_border_color = (GREEN,BLACK,OFF)
searchbox_color = dialog_color
searchbox_title_color = title_color
searchbox_border_color = border_color
position_indicator_color = title_color
menubox_color = dialog_color
menubox_border_color = border_color
item_color = (GREEN,BLACK,OFF)
item_selected_color = (GREEN,BLACK,ON,OFF,ON)
tag_color = (GREEN,BLACK,ON)
tag_selected_color = (GREEN,BLACK,ON,OFF,ON)
tag_key_color = (GREEN,BLACK,ON)
tag_key_selected_color = (GREEN,BLACK,ON,OFF,ON)
check_color = dialog_color
check_selected_color = button_active_color
uarrow_color = (GREEN,BLACK,ON)
darrow_color = uarrow_color
itemhelp_color = (GREEN,BLACK,OFF)
form_active_text_color = button_active_color
form_text_color = (GREEN,BLACK,OFF)
form_item_readonly_color = (GREEN,BLACK,ON)
gauge_color = (GREEN,BLACK,ON,OFF,ON)
border2_color = dialog_color
inputbox_border2_color = dialog_color
searchbox_border2_color = dialog_color
menubox_border2_color = dialog_color
